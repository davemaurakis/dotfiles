# ALIASES
alias ls='ls -FG'
alias ll='ls -a'
alias la='ll -lh'
alias mkdir='mkdir -pv'
alias j='jobs -l'
alias rm='rm -v'
alias tree='tree -a'
alias cpu='top -o cpu'
alias grep='grep --color=auto -C 3'
alias wget='wget -c' # make wget resume downloads by defauls
alias ctags="`brew --prefix`/bin/ctags"

alias crontab='VISUAL=vi crontab'

export LESS='-R-i-P%f (%i/%m) Line %lt/%L'
